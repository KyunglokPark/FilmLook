{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iDFilm",
  "mainBinaryName": "iDFilm",
  "version": "0.1.0",
  "identifier": "com.idoit.idfilm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1434",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "iDFilm",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
